# Basis-URL der Website. Steuert metadataBase, Canonical-URLs, Sitemap,
# robots.txt und die absoluten Bild-URLs für Social-Media-Vorschauen.
# Ohne diesen Wert greift der Platzhalter aus app/lib/site.ts.
NEXT_PUBLIC_SITE_URL=https://www.ihre-domain.de

# Google Search Console: Inhaberschaft per HTML-Tag bestätigen. Nur den Wert
# aus content="..." eintragen, nicht das ganze <meta>-Tag.
GOOGLE_SITE_VERIFICATION=
